# ── Supabase (create a free project at https://supabase.com) ──────────────
# Leave these unset to run the site in DEMO MODE with bundled sample data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Razorpay (https://dashboard.razorpay.com) ─────────────────────────────
# Leave unset until KYC is approved — checkout will offer COD/pay-at-pickup only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Shop ──────────────────────────────────────────────────────────────────
# WhatsApp number that receives order messages (country code, no +)
NEXT_PUBLIC_SHOP_WHATSAPP=919999999999
NEXT_PUBLIC_SITE_URL=http://localhost:3000
